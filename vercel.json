{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/projects", "destination": "/projects.html" },
    { "source": "/projects/:slug", "destination": "/projects/:slug.html" },
    { "source": "/services", "destination": "/services.html" },
    { "source": "/shop", "destination": "/shop.html" },
    { "source": "/download", "destination": "/download.html" },
    { "source": "/((?!assets|favicon|magazine|sitemap|robots|api).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/contact.ts": {
      "maxDuration": 10
    },
    "api/webhook.ts": {
      "maxDuration": 10
    },
    "api/download.ts": {
      "maxDuration": 10
    },
    "api/create-checkout.ts": {
      "maxDuration": 10
    }
  }
}
