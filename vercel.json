{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/((?!assets|favicon|magazine|sitemap|robots|api).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/webhook.ts": {
      "maxDuration": 10
    },
    "api/download.ts": {
      "maxDuration": 10
    },
    "api/create-checkout.ts": {
      "maxDuration": 10
    }
  }
}
