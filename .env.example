# Public frontend configuration (safe to expose in the browser).
# Replace with the Sanity project/dataset you intend to READ during development.
VITE_SANITY_PROJECT_ID=29vr82eu
VITE_SANITY_DATASET=production

# Server-only. Never prefix secrets with VITE_ or commit .env.local.
# Contact returns 503 until all three email settings are supplied.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Example format: Hiên Studio <contact@your-verified-domain.example>
CONTACT_FROM=

# Optional locally; configure both in deployed environments for rate limiting.
# Configuring only one fails closed. Do not mix preview and production Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe test-mode keys for preview/development only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Generate a long random secret for each environment.
DOWNLOAD_JWT_SECRET=

# Server-side Sanity. Token is needed only for private content.
SANITY_PROJECT_ID=29vr82eu
SANITY_DATASET=production
SANITY_API_TOKEN=

# API redirect fallback when VERCEL_URL is absent.
# Existing checkout/download routes prioritize Vercel's VERCEL_URL.
BASE_URL=http://localhost:3000
